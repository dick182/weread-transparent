# 依赖
node_modules/

# 打包中间产物（含 electron-builder 失败时临时挪出的 dist_old_* / dist_prev 等）
dist*/
out/
release/_stage/

# release 里只收说明文件；exe / zip 体积大，走本地分发或 GitHub Releases
release/*
!release/使用说明.txt

# 调试产物（CDP 截图、抽帧、临时脚本）
frames/
cycles/
*.shot.png
v2_*.png
live*.png
s_hover.png
crop_ok.png
crop_bad.png
frame.js

# 运行时日志
*.log
logs/

# 便携版数据目录（放 portable.txt 时产生，含登录态）
data/
portable.txt

# 系统 / 编辑器
